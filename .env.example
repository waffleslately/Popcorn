# ─── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on (Render injects this automatically)
PORT=3000

# Comma-separated allowed CORS origins. Leave empty to run in same-origin mode
# (recommended for production on Render where server serves the frontend too).
# Example for local dev with a separate Vite server:
#   CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=

# ─── TMDB (Movie Discovery) ────────────────────────────────────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
# Supports both v3 API keys (32-char hex) and v4 Bearer tokens (starts with eyJ).
# The key is NEVER sent to the browser — the server proxies all TMDB requests.
TMDB_API_KEY=

# ─── Client (Vite build-time) ──────────────────────────────────────────────────
# Override the server URL used by the React app at build time.
# Leave empty for same-origin (recommended when server serves the frontend).
# Example for a separate API server:
#   VITE_SERVER_URL=https://api.myapp.com
VITE_SERVER_URL=

# ─── Future / Optional ─────────────────────────────────────────────────────────
# Supabase (if you swap MemoryRoomStore for a persistent Supabase store)
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
